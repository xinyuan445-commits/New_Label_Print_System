# Copy to .env and adjust for local/prod usage.
# .env is git-ignored.

# PostgreSQL password used by both db and web services
POSTGRES_PASSWORD=change-me-strong-password

# Flask secret key — used for sessions/CSRF. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generated-hex

# 有模板管理权限的账号共用模板；常用单据仍按账号保存。
SHARED_TEMPLATES=1

# 默认仅本机访问；增加内网地址时用逗号分隔，例如 127.0.0.1,172.16.10.45。
LABEL_HOSTS=127.0.0.1
LABEL_PORT=18003

# 本机首次启动管理员；密码留空时生成随机密码，仅在首次创建时输出。
LABEL_ADMIN_EMAIL=admin@local.test
LABEL_ADMIN_PASSWORD=

# Docker 首次管理员：启动后执行 docker compose exec web flask seed-admin。
# 与本机 LABEL_ADMIN_* 是两套初始化入口；已有账号不会被覆盖。
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=
# HTTPS 入口使用 1；HTTP 本机试运行由 local_server.py 固定使用非 Secure Cookie。
COOKIE_SECURE=0
TZ=Asia/Shanghai

# U8 查询账套：998 支持测试打印，008 仅供查询，禁止打印和追溯写入。
U8_DATABASE=ufdata_998_2021
# 条码第一段沿用现有 PDA 账套代码，与数据库名无关。
U8_BARCODE_ACCOUNT_CODE=008
# 自动优先选已安装的 Driver 18，其次 Driver 17；容器安装 Driver 18。
# 如需固定驱动，填写 U8_ODBC_DRIVER；留空自动选择。
U8_ODBC_DRIVER=
U8_SERVER=
U8_USER=
U8_PASSWORD=
