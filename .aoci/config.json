{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov",
    ".local-data",
    ".codex",
    "logs",
    "pdfs",
    "assets",
    "pgdata",
    "redisdata",
    ".cache"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage",
    "*.db",
    "*.db-*",
    "*.sqlite",
    "*.sqlite3",
    "*.pdf",
    "*.log",
    "*.zip",
    "*.exe",
    "*.dll",
    "*.pdb"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 7000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "starter-vendored-static-libs",
        "action": "observe",
        "pattern": "**/static/**/libs/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-lib",
        "action": "observe",
        "pattern": "**/static/**/lib/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-plugins",
        "action": "observe",
        "pattern": "**/static/**/plugins/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-js",
        "action": "observe",
        "pattern": "**/*.min.js",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 103,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-css",
        "action": "observe",
        "pattern": "**/*.min.css",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 104,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-source-map",
        "action": "observe",
        "pattern": "**/*.map",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 105,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-fonts",
        "action": "observe",
        "pattern": "**/fonts/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 106,
        "enabled": true
      },
      {
        "rule_id": "historical-design-docs",
        "action": "observe",
        "pattern": "docs/superpowers",
        "pattern_kind": "directory",
        "reason": "Historical upstream plans are reference evidence; current source defines implemented U8 behavior",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "local-aoci-downloads",
        "action": "exclude",
        "pattern": "tools/aoci/downloads",
        "pattern_kind": "directory",
        "reason": "Local downloaded release and archive; no project semantics",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "local-aoci-runtime",
        "action": "exclude",
        "pattern": "tools/aoci/runtime",
        "pattern_kind": "directory",
        "reason": "Machine-bound MCP transcripts and installation checks",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "release-licenses",
        "action": "observe",
        "pattern": "LICENSE",
        "pattern_kind": "file",
        "reason": "Retain licensing text as reference without inventing code semantics",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "screenshots",
        "action": "observe",
        "pattern": "docs/screenshots",
        "pattern_kind": "directory",
        "reason": "Training pictures and screenshots are reference assets",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [
    "codex"
  ],
  "automation": {
    "mode": "auto"
  },
  "maintain_transport_budget_bytes": 24576,
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
